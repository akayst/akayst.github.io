---
import { SITE } from '../config';
import { BLOG_CATEGORIES } from '../data/categories';
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={base}>{SITE.title}</a>
    <nav aria-label="주요 메뉴">
      <a href={`${base}blog/`}>글</a>
      <details class="category-menu">
        <summary>카테고리</summary>
        <div class="menu">
          <a href={`${base}categories/`}>전체 카테고리</a>
          {BLOG_CATEGORIES.map((category) => (
            <a href={`${base}categories/${category.slug}/`}>{category.emoji} {category.name}</a>
          ))}
        </div>
      </details>
      <a href={`${base}about/`}>소개</a>
      <a href={`${base}admin/`}>글쓰기</a>
      <button id="theme-toggle" type="button" aria-label="색상 모드 전환">◐</button>
    </nav>
  </div>
</header>

<script>
  document.querySelector('#theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 20; border-bottom: 1px solid color-mix(in srgb, var(--line) 75%, transparent); background: color-mix(in srgb, var(--bg) 84%, transparent); backdrop-filter: blur(16px); }
  .bar { height: 68px; display: flex; align-items: center; justify-content: space-between; }
  .brand { font-size: 1.1rem; font-weight: 800; letter-spacing: -.03em; }
  nav { display: flex; align-items: center; gap: 1.2rem; color: var(--muted); font-size: .93rem; }
  .category-menu { position: relative; }
  .category-menu summary { cursor: pointer; list-style: none; }
  .category-menu summary::-webkit-details-marker { display: none; }
  .category-menu[open] .menu { opacity: 1; pointer-events: auto; transform: translateY(0); }
  .menu {
    position: absolute;
    top: 120%;
    left: 0;
    z-index: 30;
    min-width: 190px;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: .55rem;
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: .35rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-8px);
    transition: all .18s ease;
  }
  .menu a {
    border-radius: 10px;
    padding: .33rem .5rem;
  }
  .menu a:hover { background: color-mix(in srgb, var(--accent-soft) 90%, transparent); color: var(--accent); }
  .category-menu summary:hover { color: var(--accent); }
  nav a:hover { color: var(--accent); }
  button { width: 34px; height: 34px; border: 1px solid var(--line); border-radius: 50%; background: var(--surface); color: var(--text); cursor: pointer; }
</style>
