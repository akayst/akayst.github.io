---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../config';
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.pubDate <= new Date()))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout>
  <section class="hero container">
    <p class="eyebrow">Notes & Stories</p>
    <h1>오래 남기고 싶은<br /><em>생각과 경험</em>을 씁니다.</h1>
    <p class="intro">{SITE.description}</p>
    <a class="button" href={`${base}blog/`}>모든 글 보기 →</a>
  </section>
  <section class="container latest">
    <div class="section-head"><h2>최근 글</h2><span>{posts.length}개의 기록</span></div>
    {posts.length ? posts.slice(0, 6).map(post => <PostCard post={post} />) : <p class="muted">아직 공개된 글이 없습니다.</p>}
  </section>
</BaseLayout>

<style>
  .hero { padding: clamp(5rem, 13vw, 9rem) 0 clamp(4rem, 9vw, 7rem); }
  h1 { max-width: 790px; margin: .6rem 0 1.2rem; font-size: clamp(2.8rem, 8vw, 6.2rem); line-height: 1.02; letter-spacing: -.065em; }
  h1 em { color: var(--accent); font-style: normal; }
  .intro { max-width: 560px; margin-bottom: 1.8rem; color: var(--muted); font-size: 1.08rem; }
  .latest { max-width: 820px; }
  .section-head { display: flex; align-items: baseline; justify-content: space-between; border-bottom: 2px solid var(--text); }
  .section-head h2 { margin: 0 0 .7rem; font-size: 1.05rem; }
  .section-head span { color: var(--muted); font-size: .8rem; }
</style>
