---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BLOG_CATEGORIES } from '../../data/categories';
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.pubDate <= new Date()))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const totals = BLOG_CATEGORIES.map((category) => {
  const count = posts.filter((post) => post.data.category === category.name).length;
  return {
    ...category,
    count,
  };
});

const totalPosts = posts.length;
---

<BaseLayout title="카테고리" description="카테고리별로 글을 모아보세요.">
  <section class="container page">
    <p class="eyebrow">Archive</p>
    <h1>카테고리</h1>
    <p class="intro muted">총 {totalPosts}개의 글</p>

    <div class="category-grid">
      {totals.map((category) => (
        <a class="category-card" href={`${base}categories/${category.slug}/`}>
          <p>{category.emoji}</p>
          <h2>{category.name}</h2>
          <span>{category.count}개의 글</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page { max-width: 900px; padding-top: 4.5rem; }
  .intro { margin-bottom: 1.8rem; }
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }
  .category-card {
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 1.2rem;
    display: grid;
    gap: .35rem;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    text-align: center;
  }
  .category-card:hover { border-color: var(--accent); color: var(--accent); }
  .category-card p { margin: .15rem 0 0; font-size: 1.3rem; }
  .category-card h2 { margin: 0; font-size: 1.1rem; }
  .category-card span { font-size: .85rem; color: var(--muted); }
</style>
