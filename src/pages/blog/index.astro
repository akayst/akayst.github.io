---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.pubDate <= new Date()))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="모든 글" description="블로그에 기록한 모든 글입니다.">
  <section class="container page">
    <p class="eyebrow">Archive</p>
    <div class="title-row"><h1>모든 글</h1><span>{posts.length}</span></div>
    <label class="search"><span>⌕</span><input id="post-search" type="search" placeholder="제목, 설명, 태그로 검색" aria-label="글 검색" /></label>
    <div id="post-list">
      {posts.map(post => <div class="search-item" data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')} ${post.data.category}`.toLowerCase()}><PostCard post={post} /></div>)}
    </div>
    <p id="empty" hidden>검색 결과가 없습니다.</p>
  </section>
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>('#post-search');
  const items = [...document.querySelectorAll<HTMLElement>('.search-item')];
  const empty = document.querySelector<HTMLElement>('#empty');
  input?.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    let visible = 0;
    items.forEach(item => { const show = item.dataset.search?.includes(query) ?? false; item.hidden = !show; visible += Number(show); });
    if (empty) empty.hidden = visible !== 0;
  });
</script>

<style>
  .page { max-width: 820px; padding-top: 4.5rem; }
  .title-row { display: flex; align-items: baseline; gap: .7rem; }
  h1 { margin: .2rem 0 1.5rem; font-size: clamp(2.5rem, 7vw, 4.8rem); letter-spacing: -.055em; }
  .title-row span { color: var(--accent); font-weight: 700; }
  .search { display: flex; align-items: center; gap: .6rem; padding: .8rem 1rem; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
  .search input { width: 100%; border: 0; outline: 0; background: transparent; color: var(--text); font: inherit; }
  #empty { padding: 3rem 0; color: var(--muted); text-align: center; }
</style>
