---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
---
<BaseLayout title="페이지를 찾을 수 없습니다">
  <section class="container not-found"><p class="eyebrow">404</p><h1>길을 잃었어요.</h1><p class="muted">요청한 페이지가 없거나 주소가 변경되었습니다.</p><a class="button" href={base}>홈으로 돌아가기</a></section>
</BaseLayout>
<style>.not-found { padding: 10rem 0; text-align: center; } h1 { margin: .4rem; font-size: clamp(2.6rem, 7vw, 5rem); letter-spacing: -.055em; } .button { margin-top: 1rem; }</style>
